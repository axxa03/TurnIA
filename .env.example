# Copiar a .env (NUNCA subir .env al repositorio)
PORT=3000
HOST=127.0.0.1
# Secreto para firmar sesiones: generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Contraseña de los usuarios demo creados en el primer arranque
DEMO_ADMIN_PASSWORD=demo1234
# Ruta de la base SQLite (opcional)
# DB_PATH=/var/lib/turnia/turnia.db

# --- Asistente IA opcional (API de IA de DonWeb u otra compatible con OpenAI /chat/completions) ---
# Si se dejan vacías, el asistente funciona solo con reglas + base de conocimiento + datos del local.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
