# Copiar a .env (NUNCA subir .env al repositorio)
PORT=3000
HOST=127.0.0.1
# Secreto para firmar sesiones: generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Contraseña de los usuarios demo creados en el primer arranque
DEMO_ADMIN_PASSWORD=demo1234
# Ruta de la base SQLite (opcional)
# DB_PATH=/var/lib/turnia/turnia.db

# --- IA conversacional (API de IA de DonWeb u otra compatible con /chat/completions) ---
# Completar SOLO en el servidor. Sin estas variables TurnIA funciona en modo simulado (reglas + base de conocimiento).
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# Timeout por llamada en ms
AI_TIMEOUT=20000
# native = usa function calling (herramientas). none = si la API no soporta herramientas.
AI_TOOL_MODE=native
